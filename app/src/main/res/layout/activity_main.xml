<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/calculator_background"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:orientation="vertical">

    <!-- Black Screen for Computation and Result -->
    <LinearLayout
        android:id="@+id/black_screen"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:minHeight="200dp"
        android:gravity="bottom"
        android:paddingBottom="24dp"
        android:layout_margin="4dp"
        android:orientation="vertical">

        <!-- Computation Display -->
        <TextView
            android:id="@+id/computation_display"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end|center_vertical"
            android:maxLines="1"
            android:ellipsize="start"
            tools:text="(12+3)×4"
            android:textColor="@color/calculator_secondary_text"
            android:textSize="36sp"
            android:fontFamily="sans-serif" />

        <!-- Result Display -->
        <TextView
            android:id="@+id/result_display"
            android:layout_width="match_parent"
            android:layout_height="112dp"
            android:gravity="end|center_vertical"
            android:text="@string/initial_result"
            android:fontFamily="sans-serif-light"
            android:maxLines="1"
            android:accessibilityLiveRegion="polite"
            app:autoSizeTextType="uniform"
            app:autoSizeMinTextSize="18sp"
            app:autoSizeMaxTextSize="90sp"
            app:autoSizeStepGranularity="1sp"
            android:textColor="@color/calculator_text"
            android:textSize="90sp" />

    </LinearLayout>

    <!-- GridLayout for Buttons -->
    <GridLayout
        android:id="@+id/gridLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="4dp"
        android:columnCount="4"
        android:rowCount="5">

        <!-- Row 1: C, (, ), ÷ -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonC"
            android:contentDescription="@string/delete"
            style="@style/ClearButton"
            android:text="@string/delete_label" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonOpenBracket"
            android:contentDescription="@string/open_parenthesis"
            android:tag="("
            style="@style/SpecialFunctionButton"
            android:text="(" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonCloseBracket"
            android:contentDescription="@string/close_parenthesis"
            android:tag=")"
            style="@style/SpecialFunctionButton"
            android:text=")" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonDivide"
            android:contentDescription="@string/divide"
            android:tag="/"
            style="@style/OperatorButton"
            android:text="÷" />

        <!-- Row 2: 7, 8, 9, × -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/button7"
            android:tag="7"
            style="@style/NumericButton"
            android:text="7" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button8"
            android:tag="8"
            style="@style/NumericButton"
            android:text="8" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button9"
            android:tag="9"
            style="@style/NumericButton"
            android:text="9" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonMultiply"
            android:contentDescription="@string/multiply"
            android:tag="*"
            style="@style/OperatorButton"
            android:text="×" />

        <!-- Row 3: 4, 5, 6, - -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/button4"
            android:tag="4"
            style="@style/NumericButton"
            android:text="4" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button5"
            android:tag="5"
            style="@style/NumericButton"
            android:text="5" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button6"
            android:tag="6"
            style="@style/NumericButton"
            android:text="6" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonSubtract"
            android:contentDescription="@string/subtract"
            android:tag="-"
            style="@style/OperatorButton"
            android:text="–" />

        <!-- Row 4: 1, 2, 3, + -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/button1"
            android:tag="1"
            style="@style/NumericButton"
            android:text="1" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button2"
            android:tag="2"
            style="@style/NumericButton"
            android:text="2" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button3"
            android:tag="3"
            style="@style/NumericButton"
            android:text="3" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonAdd"
            android:contentDescription="@string/add"
            android:tag="+"
            style="@style/OperatorButton"
            android:text="+" />

        <!-- Row 5: AC, 0, ., = -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonAC"
            android:contentDescription="@string/clear_all"
            style="@style/ClearAllButton"
            android:text="@string/clear_all_label" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button0"
            android:tag="0"
            style="@style/NumericButton"
            android:text="0" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonDecimal"
            android:contentDescription="@string/decimal_point"
            android:tag="."
            style="@style/SpecialFunctionButton"
            android:text="." />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonEquals"
            android:contentDescription="@string/equals"
            style="@style/EqualsButton"
            android:text="=" />

    </GridLayout>

    </LinearLayout>
</ScrollView>